# Copy to /etc/glacier/panel.env (chmod 600) and replace every CHANGE_ME.
# Generate secrets with: openssl rand -hex 32

# Public URL of the panel, exactly as users type it (no trailing slash).
APP_URL=https://panel.example.com
# Encrypts node secrets. Changing it later means re-pairing every node.
APP_KEY=CHANGE_ME
NODE_ENV=production

# Database (the Postgres container from deploy/docker-compose.yml). Use the same password twice.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://glacier:CHANGE_ME@127.0.0.1:5432/glacier

# Only nginx talks to the API.
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=true
LOG_LEVEL=info
