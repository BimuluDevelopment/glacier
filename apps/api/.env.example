# Public URL of the panel (used for cookies, CORS and links in emails).
APP_URL=http://localhost:5173
# 32+ random characters. Encrypts node secrets; changing it breaks paired nodes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_KEY=change-me-to-a-long-random-string-of-32-chars
DATABASE_URL=postgresql://glacier:glacier@localhost:5432/glacier
REDIS_URL=redis://localhost:6379
HOST=0.0.0.0
PORT=3000
# Set to true behind nginx/Cloudflare so client IPs are read from X-Forwarded-For.
TRUST_PROXY=false
LOG_LEVEL=info
